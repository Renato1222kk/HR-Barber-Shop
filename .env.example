# HR Barber Shop — variáveis de ambiente
#
# Copie este arquivo para .env.local e preencha com os dados do seu projeto
# Supabase (Project Settings -> API). NUNCA faça commit do .env.local.

# URL do projeto Supabase (ex.: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable Key (chave pública nova do Supabase) — PRIORIDADE
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Compatibilidade: se o seu projeto ainda usa a "anon key" clássica,
# você pode informá-la aqui em vez da Publishable Key acima.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (Opcional) URL pública do site, usada nas metatags de compartilhamento.
# NEXT_PUBLIC_SITE_URL=https://seu-dominio.com

# ATENÇÃO: NUNCA coloque aqui (nem no navegador) segredos administrativos como
# SUPABASE_SECRET_KEY, SUPABASE_SERVICE_ROLE_KEY, senha do banco ou connection string.
