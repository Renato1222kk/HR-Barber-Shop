# =====================================================================
# HR Barber Shop - variaveis de ambiente
#
# Copie este arquivo para .env.local e preencha com os dados do SEU
# projeto no Supabase (Project Settings > API Keys).
#
#   cp .env.example .env.local
#
# O arquivo .env.local NAO deve ser enviado para o GitHub
# (ja esta coberto pelo .gitignore).
# =====================================================================

# Project URL - Settings > Data API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key - Settings > API Keys > Publishable key (sb_publishable_...)
# E uma chave publica: pode ir para o navegador, porque quem protege os
# dados sao as politicas de RLS do banco.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Compatibilidade com projetos criados antes da publishable key.
# Use SOMENTE se o seu projeto ainda mostrar "anon public" no painel.
# Quando as duas existem, a publishable key tem prioridade.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional - endereco publico do app, usado nas previas de
# compartilhamento (Open Graph). Ex.: https://hrbarbershop.vercel.app
# NEXT_PUBLIC_SITE_URL=

# =====================================================================
# NUNCA coloque aqui (nem em qualquer variavel NEXT_PUBLIC_):
#   - SUPABASE_SECRET_KEY
#   - SUPABASE_SERVICE_ROLE_KEY
#   - senha do banco / connection string
# Tudo que comeca com NEXT_PUBLIC_ vai para o navegador.
# =====================================================================
